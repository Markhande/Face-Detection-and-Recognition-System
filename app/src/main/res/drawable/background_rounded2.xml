<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient background -->
    <gradient
        android:angle="90"
        android:endColor="#FFFFFF"
        android:startColor="#FFFFFF" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Optional padding (used when applied to View background) -->
    <padding
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />

    <!-- Optional border -->
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" />

</shape>

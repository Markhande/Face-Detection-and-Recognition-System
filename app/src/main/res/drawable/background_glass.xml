<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent white with subtle gradient -->
    <gradient
        android:angle="90"
        android:endColor="#E65B5B5B"
        android:startColor="#E65B5B5B"
        android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Inner padding (applies only when used directly on a View) -->
    <padding
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />

    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />  <!-- 50% white for border -->

</shape>
